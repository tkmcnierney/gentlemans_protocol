{
  "name": "gentlemans-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && node ./scripts/build-site.mjs",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "test": "node --test",
    "test:browser": "npm run build && node ./scripts/browser-check.mjs",
    "check": "npm run build && node ./scripts/check-site.mjs && npm test"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.120.0"
  }
}
